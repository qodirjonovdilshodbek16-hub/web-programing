<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Navigation</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background: #f4f6f8;
    }

    nav {
      background: #1f2937;
    }

    nav ul {
      list-style: none;
      display: flex;
      justify-content: center;
      gap: 8px;
      padding: 12px;
      flex-wrap: wrap;
    }

    nav a {
      display: block;
      padding: 10px 18px;
      color: #e5e7eb;
      text-decoration: none;
      border-radius: 6px;
      transition: background 0.2s, color 0.2s;
    }

    nav a:hover,
    nav a:focus {
      background: #3b82f6;
      color: #ffffff;
    }
  </style>
</head>
<body>
  <nav>
    <ul>
      <li><a href="#">Home</a></li>
      <li><a href="#">About Me</a></li>
      <li><a href="#">My Projects</a></li>
      <li><a href="#">Skills</a></li>
      <li><a href="#">Contact</a></li>
    </ul>
  </nav>
</body>
</html>